<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.quiettv.home" android:versionCode="5" android:versionName="1.2.0">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Only used in Dev mode, to read your public GitHub contribution calendar from github.com. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ only lets an app see the apps it asks about: launchable apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application android:label="@string/app_name" android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity android:name=".HomeActivity" android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale|layoutDirection|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false"
            android:excludeFromRecents="true" android:screenOrientation="landscape" />

        <activity android:name=".AppsActivity" android:exported="false"
            android:excludeFromRecents="true" android:screenOrientation="landscape" />

        <!-- The Home-button guard. Turned on by `quiettv.sh install`, or in Settings > Accessibility. -->
        <service android:name=".HomeGuard" android:exported="true"
            android:label="QuietTV Home button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_guard" />
        </service>
    </application>
</manifest>
